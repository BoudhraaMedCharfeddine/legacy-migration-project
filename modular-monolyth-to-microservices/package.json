{
  "name": "modular-monolyth-to-microservices",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:all": "nest build api-gateway && nest build users-service && nest build categories-service && nest build products-service && nest build orders-service && nest build payments-service",
    "start:gateway": "node dist/apps/api-gateway/apps/api-gateway/src/main",
    "start:users": "node dist/apps/users-service/apps/users-service/src/main",
    "start:categories": "node dist/apps/categories-service/apps/categories-service/src/main",
    "start:products": "node dist/apps/products-service/apps/products-service/src/main",
    "start:orders": "node dist/apps/orders-service/apps/orders-service/src/main",
    "start:payments": "node dist/apps/payments-service/apps/payments-service/src/main",
    "dev:gateway": "nest start api-gateway --watch",
    "dev:users": "nest start users-service --watch",
    "dev:categories": "nest start categories-service --watch",
    "dev:products": "nest start products-service --watch",
    "dev:orders": "nest start orders-service --watch",
    "dev:payments": "nest start payments-service --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "better-sqlite3": "^9.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
